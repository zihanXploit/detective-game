# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://detective:detective@localhost:5432/detective?schema=public"

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-of-32+-chars"

# Public origin of the app. Required in production (used to reject cross-site socket connections).
# APP_ORIGIN="https://example.com"

PORT=3000
